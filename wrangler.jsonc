{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "unbrainrot-knowledge",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {"enabled": false}
}
